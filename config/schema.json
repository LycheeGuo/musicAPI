{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SPlayer Aggregated Music Source Provider Config",
  "type": "object",
  "required": ["schemaVersion", "revision", "defaults", "providers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "crossFallback": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "reserveMs": { "type": "number", "minimum": 0 },
        "searchTimeoutMs": { "type": "number", "minimum": 1 },
        "maxCandidatesPerPlatform": { "type": "integer", "minimum": 1 },
        "maxQualityAttemptsPerProvider": { "type": "integer", "minimum": 1 },
        "minScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "platforms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "priority", "resolverProviderIds", "search"],
            "properties": {
              "id": { "enum": ["kw", "mg"] },
              "priority": { "type": "number" },
              "resolverProviderIds": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "allowDirectUrl": { "type": "boolean" },
              "search": {
                "type": "object",
                "required": ["method", "url", "listPath", "fields"],
                "properties": {
                  "method": { "enum": ["GET", "POST"] },
                  "url": { "type": "string", "pattern": "^https?://" },
                  "responseType": { "enum": ["json", "text"] },
                  "listPath": { "type": "string", "minLength": 1 },
                  "fields": {
                    "type": "object",
                    "required": ["idPath", "namePath", "singerPath"],
                    "properties": {
                      "idPath": { "type": "string", "minLength": 1 },
                      "alternateIdPath": { "type": "string" },
                      "idStripPrefix": { "type": "string" },
                      "namePath": { "type": "string", "minLength": 1 },
                      "singerPath": { "type": "string", "minLength": 1 },
                      "durationPath": { "type": "string" },
                      "directUrlPaths": {
                        "type": "array",
                        "items": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "enabled", "priority", "platforms", "transport"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
          "enabled": { "type": "boolean" },
          "priority": { "type": "number" },
          "platforms": {
            "type": "array",
            "items": { "enum": ["wy", "tx", "kg"] }
          },
          "crossPlatforms": {
            "type": "array",
            "items": { "enum": ["kw", "mg"] }
          },
          "qualities": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["lq", "sq", "hq", "lossless", "hi-res"] }
          }
        }
      }
    }
  }
}
